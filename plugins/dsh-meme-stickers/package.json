{
  "name": "dsh-meme-stickers",
  "version": "0.1.0",
  "description": "Scoped meme sticker sizing and a portable, indexed image library for DeepSeek Harness.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "provision": "node scripts/provision.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "src",
    "lib",
    "scripts/provision.mjs",
    "scripts/build.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "THIRD_PARTY_ASSETS.md",
    "README.md",
    "VALIDATION.md",
    "marketplace"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memes",
    "stickers"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "semver": "^7.7.3"
  }
}
